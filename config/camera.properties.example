# Observatory IP Camera configuration example (java.util.Properties format, UTF-8).
#
# The live file is files/camera.properties in the app-private storage of
# local.termux.observatorycamera. Never commit the live file. Use:
#   camera-control.sh -s "$TARGET" config-export --out camera.properties
#   camera-control.sh -s "$TARGET" config-import --in camera.properties
#
# Every key is optional; a missing key uses the default shown. Unknown keys and
# invalid values reject the whole import and keep the previous configuration.
# The file may be at most 8192 bytes and must be valid UTF-8.

# Burn the overlay into the JPEG pixels: on | off. Default: on
overlay=on

# Text label for the location (not GPS). 1-24 characters: letters, digits,
# spaces inside, underscore, dot, hyphen. Default: NYX
location=NYX

# bottom-left | bottom-right | top-left | top-right. Default: bottom-left
position=bottom-left

# Text size 10-96, defined for a 720 px short image side and scaled to the image. Default: 24
text_size=24

# Comma-separated overlay fields: location, datetime, fps, temperature,
# humidity, pressure, battery, battery_temperature, charging, thermal.
# Use none for no overlay text. New telemetry fields default off.
# Legacy frames entries are accepted but ignored. Default: existing three fields
fields=location,datetime,fps

# JPEG output size: auto preserves the previous nearest-to-1280x720 selection,
# or choose an exact size advertised by the selected camera, e.g. 1920x1080.
# Only Camera2 JPEG outputs up to the app's 8-megapixel limit are selectable.
# Default: auto
jpeg_size=auto

# Positive capture target in frames per second with at most one decimal digit.
# Default: 1.0. Camera timing metadata is an informational estimate only;
# actual FPS may be lower when the camera or processing cannot keep up.
# The stored 64-bit tenths representation supports up to 922337203685477580.7.
target_fps=1.0

# Camera2 focus control. Modes and ranges are selected-camera specific.
# auto | lock | manual | advertised AF mode; lock/manual are available only when supported.
# Manual focus distance is in Camera2 diopters (0 = infinity).
focus_mode=auto
focus_distance_diopters=0

# auto | manual. Manual sensor mode requires the advertised ISO and exposure ranges.
# Exposure time is in nanoseconds. Manual mode requires AE lock off and compensation zero.
exposure_mode=auto
exposure_compensation=0
ae_lock=off
iso=100
exposure_time_ns=10000000

# auto or a white-balance preset advertised by the selected camera. No manual color temperature.
white_balance=auto
awb_lock=off

# JPEG quality requested from Camera2 and used for overlay/mirror re-encoding. Range: 1-100.
jpeg_quality=90

# Automatic physical orientation or an explicit fixed-installation rotation.
orientation_mode=auto
rotation_degrees=0
mirror=off

# Overlay text color: #RRGGBB (case-insensitive, stored uppercase) or legacy green.
# The legacy green value preserves the existing appearance. A black outline and
# shadow are retained. Default: green
text_color=green

# Independent viewer telemetry panel. Default: shown with all groups enabled.
panel_enabled=on
# left | right. The panel is always below the image on narrow screens. Default: right
telemetry_position=right
panel_text_color=#FF0000
panel_background_color=#000000
panel_text_size=16
panel_environment=on
panel_device=on
panel_capture=on

# Optional BME280 MQTT subscriber. An empty host disables MQTT.
# Configure only a broker you control; no host or username/password is assumed.
mqtt_host=
mqtt_port=1883
mqtt_topic=homeassistant/nyx/reading
mqtt_tls=off
mqtt_stale_seconds=120

# MQTT credentials are not stored in or exported with this file. When needed,
# configure them separately in app-private files/mqtt-credentials.properties.
# The credential file is never returned by APIs, logs, config-export or config-import.

# When using scripts/camera-control.sh config-set, quote RGB values so the shell
# passes the leading # as part of the assignment, for example:
#   config-set 'text_color=#12ABCD' 'panel_text_color=#FF0000'
